# Development defaults only. Change credentials and lock down ports for deployments.
POSTGRES_DB=globalnews
POSTGRES_USER=globalnews
POSTGRES_PASSWORD=change-me-local-only
# Live collection is OFF; only original fictional seed content appears by default.
GDELT_ENABLED=false
FEED_REFRESH_SECONDS=60
GDELT_TIMESPAN=24h
GDELT_MAX_RECORDS=25
GDELT_MIN_INTERVAL_SECONDS=2

# Explicit API hosts; add the actual API host before remote deployment.
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1,api
API_REQUESTS_PER_MINUTE=240
API_GLOBAL_REQUESTS_PER_MINUTE=2400

# Owner links can only be issued through the trusted private CLI.
OWNER_EMAIL=bhuvanjakkula@gmail.com
OWNER_SITE_ORIGIN=http://127.0.0.1:3000

# Realistic presenter: server-only credentials. Never use NEXT_PUBLIC_ variables.
OPENAI_API_KEY=
DID_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
DID_PRESENTER_IMAGE_URL=https://create-images-results.d-id.com/DefaultPresenters/Noelle_f/image.png
# Exact permitted download hosts, only adjust after verifying provider result URLs.
DID_RESULT_HOSTS=result.d-id.com
